<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>لعبة السباق - PRO DESIGN</title>

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Cairo',sans-serif;
}

body{

background:#111827;
overflow:hidden;
color:#fff;
text-align:center;

}

.header{

position:absolute;
top:20px;
width:100%;
z-index:10;

}

.title{

font-size:42px;
font-weight:900;

}

.score{

font-size:24px;
margin-top:10px;
color:#ff6600;

}

.game{

position:relative;
width:400px;
height:100vh;
margin:auto;
background:#222;
overflow:hidden;
border-left:8px solid #fff;
border-right:8px solid #fff;

}

.road-line{

position:absolute;
width:10px;
height:100px;
background:#fff;
left:50%;
transform:translateX(-50%);

}

.car{

position:absolute;
width:70px;
height:120px;
background:#ff6600;
bottom:30px;
left:165px;
border-radius:15px;

}

.enemy{

position:absolute;
width:70px;
height:120px;
background:#dc2626;
top:-150px;
border-radius:15px;

}

.controls{

position:fixed;
bottom:20px;
width:100%;
display:flex;
justify-content:center;
gap:20px;
z-index:10;

}

.btn{

background:#ff6600;
border:none;
color:#fff;
font-size:28px;
padding:20px 30px;
border-radius:20px;
font-weight:900;

}

.game-over{

position:absolute;
top:50%;
left:50%;
transform:translate(-50%,-50%);
background:#000c;
padding:40px;
border-radius:25px;
display:none;
z-index:100;

}

.game-over h1{

font-size:50px;
margin-bottom:20px;

}

.restart{

background:#16a34a;
padding:18px 35px;
border:none;
border-radius:18px;
font-size:24px;
color:#fff;
font-weight:700;

}

</style>

</head>

<body>

<div class="header">

<div class="title">
🏎 لعبة سباق PRO DESIGN
</div>

<div class="score">
النقاط :
<span id="score">
0
</span>
</div>

</div>

<div class="game" id="game">

<div class="car" id="car"></div>

<div class="game-over" id="gameOver">

<h1>
انتهت اللعبة 😅
</h1>

<button class="restart"
onclick="location.reload()">

إعادة اللعب

</button>

</div>

</div>

<div class="controls">

<button class="btn"
onclick="moveLeft()">

⬅

</button>

<button class="btn"
onclick="moveRight()">

➡

</button>

</div>

<script>

const game =
document.getElementById("game");

const car =
document.getElementById("car");

const scoreText =
document.getElementById("score");

const gameOver =
document.getElementById("gameOver");

let carLeft = 165;

let score = 0;

let speed = 5;

let enemyCars = [];

let gameRunning = true;

/* ROAD LINES */

for(let i=0;i<5;i++){

const line =
document.createElement("div");

line.classList.add("road-line");

line.style.top =
(i * 180) + "px";

game.appendChild(line);

}

/* MOVE ROAD */

function moveRoad(){

const lines =
document.querySelectorAll(".road-line");

lines.forEach(line => {

let top =
parseInt(line.style.top);

top += speed;

if(top > window.innerHeight){

top = -100;

}

line.style.top =
top + "px";

});

}

/* CREATE ENEMY */

function createEnemy(){

const enemy =
document.createElement("div");

enemy.classList.add("enemy");

enemy.style.left =
(Math.random() > 0.5 ? 80 : 250) + "px";

game.appendChild(enemy);

enemyCars.push(enemy);

}

/* MOVE ENEMIES */

function moveEnemies(){

enemyCars.forEach((enemy,index)=>{

let top =
enemy.offsetTop;

top += speed + 2;

enemy.style.top =
top + "px";

if(top > window.innerHeight){

enemy.remove();

enemyCars.splice(index,1);

score++;

scoreText.innerText =
score;

}

/* COLLISION */

if(

top + 120 > car.offsetTop &&
top < car.offsetTop + 120 &&
enemy.offsetLeft < car.offsetLeft + 70 &&
enemy.offsetLeft + 70 > car.offsetLeft

){

endGame();

}

});

}

/* PLAYER */

function moveLeft(){

if(carLeft > 30){

carLeft -= 85;

car.style.left =
carLeft + "px";

}

}

function moveRight(){

if(carLeft < 250){

carLeft += 85;

car.style.left =
carLeft + "px";

}

}

/* KEYBOARD */

document.addEventListener(
"keydown",
e=>{

if(e.key === "ArrowLeft"){

moveLeft();

}

if(e.key === "ArrowRight"){

moveRight();

}

}
);

/* GAME LOOP */

function gameLoop(){

if(!gameRunning) return;

moveRoad();

moveEnemies();

requestAnimationFrame(gameLoop);

}

/* GAME OVER */

function endGame(){

gameRunning = false;

gameOver.style.display =
"block";

}

/* START */

setInterval(()=>{

if(gameRunning){

createEnemy();

}

},1500);

gameLoop();

</script>

</body>

</html>