<script>
let doorType = "single";
let ctx = document.getElementById("doorCanvas").getContext("2d");

function setDoorType(type){
  doorType = type;

  // إظهار خيار القفل فقط للبابين
  document.getElementById("lockSide").style.display =
    (type === "double") ? "block" : "none";

  drawDoor();
}

function drawDoor(){
  ctx.clearRect(0,0,200,200);

  if(doorType === "single"){
    // باب واحد
    ctx.strokeRect(50,20,100,160);
    ctx.beginPath();
    ctx.moveTo(50,100);
    ctx.lineTo(150,20);
    ctx.moveTo(50,100);
    ctx.lineTo(150,180);
    ctx.stroke();
  }

  if(doorType === "double"){
    // بابين عكس بعض
    // اليسار
    ctx.strokeRect(20,20,70,160);
    ctx.beginPath();
    ctx.moveTo(90,100);
    ctx.lineTo(20,20);
    ctx.moveTo(90,100);
    ctx.lineTo(20,180);
    ctx.stroke();

    // اليمين
    ctx.strokeRect(110,20,70,160);
    ctx.beginPath();
    ctx.moveTo(110,100);
    ctx.lineTo(180,20);
    ctx.moveTo(110,100);
    ctx.lineTo(180,180);
    ctx.stroke();
  }

  if(doorType === "onehalf"){
    // باب وربع
    ctx.strokeRect(20,20,50,160); // الربع
    ctx.strokeRect(80,20,100,160); // الباب الرئيسي

    ctx.beginPath();
    ctx.moveTo(80,100);
    ctx.lineTo(180,20);
    ctx.moveTo(80,100);
    ctx.lineTo(180,180);
    ctx.stroke();
  }
}

// أول تشغيل
drawDoor();
</script>